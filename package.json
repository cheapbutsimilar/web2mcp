{
  "name": "web2mcp",
  "version": "0.1.0",
  "description": "No official API? Record once, get a local MCP server.",
  "type": "module",
  "bin": {
    "web2mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
