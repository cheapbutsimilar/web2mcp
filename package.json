    "typescript": "^5.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheapbutsimilar/web2mcp.git"
  }
